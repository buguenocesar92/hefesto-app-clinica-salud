<?xml version="1.0" encoding="UTF-8"?>
<!--
    Configuracion de PHPUnit de ClinicaSalud.

    Las suites `Aislamiento` y `Permisos` estan separadas a proposito:

      - `Aislamiento`: una clinica no puede leer los datos de otra. Usa
        Row Level Security de PostgreSQL.
      - `Permisos`: dentro de la clinica, recepcion no puede leer la ficha
        clinica y el profesional tratante si.

    Se pueden correr solas:
        php artisan test --testsuite=Aislamiento
        php artisan test --testsuite=Permisos
-->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
         cacheDirectory=".phpunit.cache"
         failOnWarning="true"
         failOnRisky="true"
         beStrictAboutOutputDuringTests="true">
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
        <testsuite name="Aislamiento">
            <directory>tests/Feature/Aislamiento</directory>
        </testsuite>
        <testsuite name="Permisos">
            <directory>tests/Feature/Permisos</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <!--
            IMPORTANTE: la base de pruebas tiene que ser PostgreSQL, no SQLite.

            El aislamiento entre clinicas esta implementado con Row Level
            Security, que es una funcion de PostgreSQL. En SQLite estas
            pruebas pasarian sin comprobar nada. Ver docs/10.
        -->
        <env name="DB_CONNECTION" value="pgsql"/>
        <env name="DB_DATABASE" value="clinica_salud_test"/>
    </php>
</phpunit>