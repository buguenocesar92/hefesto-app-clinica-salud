{
    "name": "hefesto/clinica-salud",
    "type": "project",
    "description": "API de ClinicaSalud, aplicacion propia de Hefesto Studio para clinicas y centros de salud. Software original de Hefesto: no es un despliegue de una herramienta de terceros.",
    "keywords": ["hefesto", "clinica", "salud", "multitenant", "laravel"],
    "license": "proprietary",
    "require": {
        "php": "^8.3",
        "ext-json": "*",
        "ext-mbstring": "*",
        "ext-openssl": "*",
        "ext-pdo": "*",
        "laravel/framework": "^13.37",
        "laravel/socialite": "^5.31",
        "firebase/php-jwt": "^7.2",
        "predis/predis": "^3.7"
    },
    "require-dev": {
        "fakerphp/faker": "^1.24",
        "phpunit/phpunit": "^13.0.3"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "@php artisan package:discover --ansi"
        ],
        "test": [
            "@php artisan config:clear --ansi",
            "@php artisan test"
        ],
        "test:aislamiento": [
            "@php artisan test --testsuite=Aislamiento"
        ],
        "test:permisos": [
            "@php artisan test --testsuite=Permisos"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}